{
  "expo": {
    "name": "Barbearia Nexus",
    "slug": "barbearia-nexus",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "barbearianexus",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.seunome.barbearianexus"
    },
    "android": {
      "package": "com.seunome.barbearianexus"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Usamos a câmera só para ler o QR code do dono da barbearia."
        }
      ],
      "expo-notifications",
      "expo-font",
      "expo-status-bar"
    ]
  }
}
