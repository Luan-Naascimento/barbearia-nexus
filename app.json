{
  "expo": {
    "name": "Barbearia Nexus",
    "slug": "barbearia-nexus",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "barbearianexus",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.luannascimento.barbearianexus"
    },
    "icon": "./assets/images/nexus-favicon.png",
    "android": {
      "package": "com.luannascimento.barbearianexus",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Barbearia Nexus",
      "shortName": "Nexus",
      "themeColor": "#171717",
      "backgroundColor": "#FFFFFF",
      "favicon": "./assets/images/nexus-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Usamos a câmera só para ler o QR code do dono da barbearia."
        }
      ],
      "expo-notifications",
      "expo-font",
      "expo-status-bar"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d53c0435-80f1-415d-a69f-41cbd26384d9"
      }
    }
  }
}
